# Lokal nur auf diesem PC. Fürs Handy im WLAN: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8300

# Nur diesem Proxy wird die weitergereichte Besucher-IP geglaubt (für die Login-Sperre).
# Auf dem VPS mit Nginx Proxy Manager in Docker dessen Adresse ergänzen, z. B. 127.0.0.1,172.17.0.1
TRUSTED_PROXIES=127.0.0.1,::1

# Alles Folgende geht auch bequem auf der Seite unter "einstellungen".
# Was dort eingetragen ist, hat Vorrang vor den Werten hier.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter braucht zusätzlich ein Modell, z.B. google/gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Fotos zu den Rezepten (kostenloser "Access Key": unsplash.com/developers → New Application)
UNSPLASH_ACCESS_KEY=

# Welcher Anbieter vorausgewählt ist (deepseek, gemini oder openrouter)
AI_DEFAULT=gemini

# Kostenbremse: höchstens so viele KI-Anfragen pro Stunde
AI_LIMIT_PER_HOUR=40

# Supermarkt-Angebote zu den Zutaten (wie beim Angebote-Bot). Leer lassen = Zweibrücken
OFFERS_ZIP=66482
OFFERS_KAUFDA_CITY=Zweibruecken
OFFERS_LAT=49.2497
OFFERS_LNG=7.3606
OFFERS_RETAILERS=Lidl,Aldi Süd,Aldi Nord,Kaufland,Rewe,Edeka,Netto Marken-Discount,Penny
# Märkte, die Marktguru nicht kennt (über kaufDA); leer = aus
OFFERS_KAUFDA_RETAILERS=Globus

# Digimon-Partner: "Gekocht!"-Knopf im Rezept füttert deinen Partner (leer = Knopf aus)
# Lokal http://localhost:8420, sonst die öffentliche Adresse der Partner-Seite
PARTNER_URL=
